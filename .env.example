# ANFSF Environment Configuration
# Copy this file to .env and fill in your values.

# ================================
# Server
# ================================
# Host to bind the server (default: 0.0.0.0)
ANFSF_HOST=0.0.0.0
# Port to listen on (default: 3000)
ANFSF_PORT=3000

# ================================
# LLM
# ================================
# API key for your LLM provider (required for pipeline synthesis)
# - DashScope (Qwen): starts with sk-
# - DeepSeek: starts with sk-ds-
LLM_API_KEY=
# Default model to use (default: qwen3.5-plus)
# Qwen models: qwen3.5-plus, qwen3.5-turbo, qwen-max
# DeepSeek models: deepseek-chat, deepseek-v4, deepseek-v4-pro, deepseek-r1
ANFSF_MODEL=qwen3.5-plus
# Custom base URL (optional — auto-detected from API key prefix)
# DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:  https://api.deepseek.com/v1
LLM_BASE_URL=

# ================================
# Security
# ================================
# Bearer token for API authentication (leave empty for dev mode — logs warning; SET for production)
ANFSF_API_TOKEN=
# Comma-separated allowed CORS origins (default: localhost/127.0.0.1 only)
ANFSF_ALLOWED_ORIGINS=http://localhost:8080
# Block requests containing prompt injection patterns (default: false — logs warnings only)
ANFSF_BLOCK_INJECTIONS=false
# Max requests per second per client (default: 5)
ANFSF_RATE_LIMIT_QPS=5
# Burst allowance (default: 10)
ANFSF_RATE_LIMIT_BURST=10

# ================================
# Logging
# ================================
# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
# Log file path (optional — when set, enables rotating file logging: 10MB max, 5 files)
# Leave empty for stderr-only (suitable for Docker/container environments)
# LOG_FILE=/var/log/anfsf/anfsf.log

# ================================
# External Review (unused placeholder)
# ================================
# EXTERNAL_REVIEW_DB_HOST=localhost
# EXTERNAL_REVIEW_DB_PORT=5432
# EXTERNAL_REVIEW_DB_NAME=anfsf_review
# EXTERNAL_REVIEW_DB_USER=anfsf
# EXTERNAL_REVIEW_DB_PASSWORD=

# ================================
# Database
# ================================
# PostgreSQL password (used by docker-compose.yml; change for production)
POSTGRES_PASSWORD=
# Set to enable PostgreSQL (e.g., postgresql://anfsf:PASSWORD@postgres:5432/anfsf)
# Leave empty to use SQLite (default for development)
DATABASE_URL=
# Data retention: delete pipeline runs older than N days (0 = keep forever)
ANFSF_DATA_RETENTION_DAYS=30
# Block requests containing prompt injection patterns (default: true)
# ANFSF_BLOCK_INJECTIONS=true
# PostgreSQL connection string — if set, use PostgreSQL; if empty, use SQLite (default)
# DATABASE_URL=postgresql://anfsf:PASSWORD@localhost:5432/anfsf
# PostgreSQL pool size (default: 5)
# PG_POOL_MAX=5
# PostgreSQL statement timeout in ms (default: 30000)
# PG_STATEMENT_TIMEOUT=30000
# Grafana admin password (used by docker-compose.yml)
GRAFANA_ADMIN_PASSWORD=anfsf_secure_password
