"""
阿里云百炼模型客户端
支持音视频转文字(ASR)功能

重构版本：集成 ProviderRouter、重试机制、降级策略、健康检查
符合 ANFSF V1.5.0 架构规范
"""
import os
import asyncio
import time
import json
from typing import Optional, Dict, Any, List
from dataclasses import dataclass
import httpx

from config.bailian import BailianConfig, get_bailian_config
from governance.provider_router import (
    ProviderRouter,
    ProviderConfig,
    RouterConfig,
    RoutingStrategy,
    get_provider_router,
)


@dataclass
class TranscriptionTask:
    """转写任务信息"""
    task_id: str
    status: str  # PENDING, RUNNING, SUCCEEDED, FAILED, TIMEOUT
    audio_url: Optional[str] = None
    video_url: Optional[str] = None
    result_url: Optional[str] = None
    text: Optional[str] = None
    error_message: Optional[str] = None
    created_at: Optional[int] = None
    completed_at: Optional[int] = None
    provider_id: Optional[str] = None
    retry_count: int = 0


class BailianClient:
    """
    阿里云百炼模型客户端
    
    功能增强：
    - 集成 ProviderRouter 实现多 Provider 路由
    - 自动重试机制(最多 3 次)
    - 降级策略(fallback 到备用 Provider)
    - 健康检查和监控
    """
    
    def __init__(self, config: Optional[Dict[str, Any]] = None):
        """
        初始化百炼客户端
        
        Args:
            config: 配置字典
        """
        config = config or {}
        self.api_key = config.get("api_key") or os.getenv("ALIYUN_BAILIAN_API_KEY")
        self.base_url = config.get("base_url") or os.getenv(
            "ALIYUN_BAILIAN_BASE_URL",
            "https://dashscope.aliyuncs.com/api/v1"
        )
        
        self.headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json"
        }
        
        # 转写模型 (主模型: 支持 file_urls 参数)
        self.transcription_model = "qwen3-asr-flash-filetrans"
        # 兜底模型 (兼容单 URL)
        self.fallback_model = "paraformer-realtime-v2"
        
        # 重试配置
        self.max_retries = 3
        self.retry_delay = 1.0  # 秒
        self.timeout = 60  # 秒
        
        # Provider 路由器
        self.router = get_provider_router()
        
        # 注册百炼 Provider
        self._register_provider()
    
    async def _validate_url(self, url: str, timeout: int = 5) -> bool:
        """
        URL 有效性预检 (HEAD 请求)
        
        Args:
            url: 需要验证的 URL
            timeout: 超时时间(秒)
            
        Returns:
            bool: URL 是否有效
        """
        async with httpx.AsyncClient(timeout=timeout) as client:
            try:
                response = await client.head(url)
                return response.status_code == 200
            except Exception:
                return False
    
    def _register_provider(self) -> None:
        """注册百炼 Provider 到路由器"""
        provider_config = ProviderConfig(
            id="bailian",
            name="阿里云百炼",
            base_url=self.base_url,
            api="audio_transcription",
            priority=2,  # 高优先级
            weight=3,
            timeout_ms=self.timeout * 1000,
            max_retries=self.max_retries,
            enabled=True,
            health_check_enabled=True,
            health_check_interval_ms=60000,
            health_check_timeout_ms=5000
        )
        self.router.register_provider(provider_config)
    
    async def transcribe_audio(
        self,
        audio_url: str,
        language: str = "zh-CN",
        callback_url: Optional[str] = None
    ) -> TranscriptionTask:
        """
        音频转文字(带重试和 fallback)
        
        Args:
            audio_url: 音频文件 URL(必须是可公开访问的 URL 或 OSS URL)
            language: 语言代码，默认 zh-CN
            callback_url: 回调 URL(可选，异步通知)
            
        Returns:
            TranscriptionTask: 转写任务信息
        """
        return await self._execute_with_retry(
            self._transcribe_audio_internal,
            audio_url=audio_url,
            language=language,
            callback_url=callback_url,
            is_video=False
        )
    
    async def _transcribe_audio_internal(
        self,
        audio_url: str,
        language: str = "zh-CN",
        callback_url: Optional[str] = None,
        provider_id: str = "bailian",
        use_fallback: bool = False
    ) -> TranscriptionTask:
        """
        内部音频转写方法(无重试)
        
        Args:
            audio_url: 音频文件 URL
            language: 语言代码
            callback_url: 回调 URL
            provider_id: Provider ID
            use_fallback: 是否使用兜底模型 (单 URL 模式)
            
        Returns:
            TranscriptionTask: 转写任务信息
        """
        start_time = time.time()
        
        async with httpx.AsyncClient(timeout=self.timeout) as client:
            try:
                # 选择模型
                model = self.fallback_model if use_fallback else self.transcription_model
                
                # 构建 payload
                if use_fallback:
                    # 兜底模式: 单 URL
                    payload = {
                        "model": model,
                        "input": {
                            "file_url": audio_url
                        },
                        "parameters": {
                            "format": "json",
                            "language": language
                        }
                    }
                else:
                    # 主模式: file_urls 支持多个 URL
                    payload = {
                        "model": model,
                        "input": {
                            "file_urls": [audio_url] if isinstance(audio_url, str) else audio_url
                        },
                        "parameters": {
                            "format": "json",
                            "language": language
                        }
                    }
                
                if callback_url:
                    payload["callback"] = callback_url
                
                response = await client.post(
                    f"{self.base_url}/services/audio/transcription",
                    headers=self.headers,
                    json=payload
                )
                response.raise_for_status()
                data = response.json()
                
                # 计算响应时间
                response_time_ms = (time.time() - start_time) * 1000
                self.router.record_result(provider_id, success=True, response_time_ms=response_time_ms)
                
                task_id = data.get("task_id", "") or data.get("output", {}).get("task_id", "")
                
                return TranscriptionTask(
                    task_id=task_id,
                    status=data.get("status", "PENDING"),
                    audio_url=audio_url,
                    created_at=int(time.time()),
                    provider_id=provider_id
                )
                
            except httpx.HTTPStatusError as e:
                response_time_ms = (time.time() - start_time) * 1000
                self.router.record_result(provider_id, success=False, response_time_ms=response_time_ms)
                
                return TranscriptionTask(
                    task_id="",
                    status="FAILED",
                    error_message=f"百炼 API 请求失败：{e.response.status_code} - {e.response.text}",
                    provider_id=provider_id
                )
            except httpx.RequestError as e:
                response_time_ms = (time.time() - start_time) * 1000
                self.router.record_result(provider_id, success=False, response_time_ms=response_time_ms)
                
                return TranscriptionTask(
                    task_id="",
                    status="FAILED",
                    error_message=f"百炼 API 连接失败：{str(e)}",
                    provider_id=provider_id
                )
    
    async def transcribe_video(
        self,
        video_url: str,
        language: str = "zh-CN",
        callback_url: Optional[str] = None
    ) -> TranscriptionTask:
        """
        视频转文字(提取音频后转写)
        
        Args:
            video_url: 视频文件 URL
            language: 语言代码
            callback_url: 回调 URL
            
        Returns:
            TranscriptionTask: 转写任务信息
        """
        return await self._execute_with_retry(
            self._transcribe_audio_internal,
            audio_url=video_url,
            language=language,
            callback_url=callback_url,
            is_video=True
        )
    
    async def _execute_with_retry(
        self,
        operation,
        **kwargs
    ) -> TranscriptionTask:
        """
        执行带重试和 fallback 的操作
        
        Args:
            operation: 要执行的操作
            **kwargs: 操作参数
            
        Returns:
            TranscriptionTask: 任务结果
        """
        last_error: Optional[str] = None
        provider_id = "bailian"  # 默认 Provider
        
        for attempt in range(self.max_retries):
            try:
                # 选择 Provider
                try:
                    routing_result = self.router.select_provider()
                    provider_id = routing_result.selected_provider
                except ValueError as e:
                    # 没有可用 Provider，使用默认
                    provider_id = "bailian"
                
                # 执行操作
                kwargs["provider_id"] = provider_id
                result = await operation(**kwargs)
                
                # 检查是否成功
                if result.status != "FAILED":
                    result.retry_count = attempt
                    return result
                
                last_error = result.error_message
                
                # 失败后等待重试
                if attempt < self.max_retries - 1:
                    await asyncio.sleep(self.retry_delay * (attempt + 1))
                    
            except Exception as e:
                last_error = str(e)
                if attempt < self.max_retries - 1:
                    await asyncio.sleep(self.retry_delay * (attempt + 1))
        
        # 所有重试失败，尝试 fallback
        fallback_result = await self._execute_fallback(operation, **kwargs)
        if fallback_result:
            return fallback_result
        
        # 完全失败
        return TranscriptionTask(
            task_id="",
            status="FAILED",
            error_message=f"所有重试和 fallback 均失败：{last_error}",
            retry_count=self.max_retries
        )
    
    async def _execute_fallback(self, operation, **kwargs) -> Optional[TranscriptionTask]:
        """
        执行 fallback 策略
        
        Args:
            operation: 要执行的操作
            **kwargs: 操作参数
            
        Returns:
            Optional[TranscriptionTask]: fallback 结果，如果失败则返回 None
        """
        # 获取 fallback Provider
        fallback_provider = self.router.get_fallback_provider("bailian")
        
        if not fallback_provider:
            return None
        
        print(f"[BailianClient] 🔄 Falling back to provider: {fallback_provider}")
        # 注意：这里需要根据实际的 fallback Provider 实现不同的调用逻辑
        # 当前简化处理，仅记录 fallback 尝试
        return None
    
    async def _fallback_to_path_one(
        self,
        tikhub_play_addr: str,
        language: str = "zh-CN",
        timeout: int = 600,
        extract_points: bool = True
    ) -> Dict[str, Any]:
        """
        兜底路径一：TikHub URL → OSS → 百炼识别
        
        Args:
            tikhub_play_addr: TikHub 解析的 play_addr
            language: 语言代码
            timeout: 超时时间(秒)
            extract_points: 是否需要观点提炼
            
        Returns:
            Dict: 转写结果
        """
        try:
            from oss_storage import OSSStorageProvider
            
            # 获取 OSS config
            oss_config = {
                "api_key": os.getenv("ALIYUN_ACCESS_KEY_SECRET"),
                "endpoint": os.getenv("OSS_ENDPOINT", "oss-cn-hangzhou.aliyuncs.com"),
                "bucket": os.getenv("OSS_BUCKET", "jieyue-media")
            }
            
            oss = OSSStorageProvider("jieyue-oss", oss_config)
            
            # 1. 从 TikHub 下载音频
            import tempfile
            with tempfile.NamedTemporaryFile(suffix=".mp3", delete=False) as tmp:
                tmp_path = tmp.name
            
            # 获取视频 URL 并下载
            import httpx
            async with httpx.AsyncClient(timeout=120) as client:
                response = await client.get(tikhub_play_addr)
                response.raise_for_status()
                with open(tmp_path, "wb") as f:
                    f.write(response.content)
            
            # 2. 上传到 OSS
            import uuid
            object_name = f"transcribe/{uuid.uuid4().hex}.mp3"
            oss_url = await oss.upload(tmp_path, object_name)
            
            # 3. 百炼识别 OSS URL
            task = await self._transcribe_audio_internal(
                oss_url,
                language=language,
                use_fallback=True  # 兜底模型
            )
            
            if task.status == "FAILED":
                return {
                    "success": False,
                    "error": task.error_message,
                    "strategy": "path_one_oss_fallback"
                }
            
            # 4. 等待完成
            result = await self.wait_for_completion(task.task_id, timeout)
            
            if result.status == "SUCCEEDED":
                response = {
                    "success": True,
                    "text": result.text,
                    "task_id": result.task_id,
                    "provider_id": result.provider_id,
                    "strategy": "path_one_oss_fallback"
                }
                
                # 5. 观点提炼
                if extract_points:
                    points_result = await self._extract_points(result.text)
                    response["points"] = points_result.get("bullet_points", "")
                    response["points_success"] = points_result.get("success", False)
                
                return response
            else:
                return {
                    "success": False,
                    "error": result.error_message or f"任务状态：{result.status}",
                    "strategy": "path_one_oss_fallback"
                }
                
        except Exception as e:
            return {
                "success": False,
                "error": f"兜底路径失败：{str(e)}",
                "strategy": "path_one_failed"
            }
    
    async def _extract_points(self, text: str, model: str = "qwen3-plus") -> Dict[str, Any]:
        """
        观点提炼 (使用 Qwen 大模型)
        
        Args:
            text: 转写文字
            model: 使用的大模型
            
        Returns:
            Dict: 提炼后的观点 (bullet points)
        """
        async with httpx.AsyncClient(timeout=30) as client:
            try:
                prompt = "请从以下转写文字中提取核心观点，总结要点，输出结构化 bullet points。如果内容包含多个任务/议题，请分别提炼。"
                
                payload = {
                    "model": model,
                    "input": {
                        "prompt": f"{prompt}\n\n转写文字:\n{text}"
                    },
                    "parameters": {
                        "temperature": 0.3,
                        "max_tokens": 1024
                    }
                }
                
                response = await client.post(
                    f"{self.base_url}/services/aigc/multimodal-generation",
                    headers=self.headers,
                    json=payload
                )
                response.raise_for_status()
                data = response.json()
                
                output = data.get("output", {})
                
                return {
                    "success": True,
                    "bullet_points": output.get("text", ""),
                    "model": model
                }
                
            except Exception as e:
                return {
                    "success": False,
                    "error": str(e),
                    "model": model
                }
    
    async def get_task_status(self, task_id: str) -> TranscriptionTask:
        """
        查询任务状态
        
        Args:
            task_id: 任务 ID
            
        Returns:
            TranscriptionTask: 任务信息(包含结果)
        """
        async with httpx.AsyncClient(timeout=self.timeout) as client:
            try:
                response = await client.get(
                    f"{self.base_url}/tasks/{task_id}",
                    headers=self.headers
                )
                response.raise_for_status()
                data = response.json()
                
                output = data.get("output", {})
                
                return TranscriptionTask(
                    task_id=task_id,
                    status=data.get("status", "UNKNOWN"),
                    text=output.get("text", "") or output.get("transcript", ""),
                    result_url=output.get("result_url"),
                    completed_at=int(time.time()) if data.get("status") == "SUCCEEDED" else None
                )
                
            except httpx.HTTPStatusError as e:
                return TranscriptionTask(
                    task_id=task_id,
                    status="FAILED",
                    error_message=f"查询任务状态失败：{e.response.status_code}"
                )
    
    async def wait_for_completion(
        self,
        task_id: str,
        timeout: int = 600,
        poll_interval: int = 5
    ) -> TranscriptionTask:
        """
        等待任务完成
        
        Args:
            task_id: 任务 ID
            timeout: 超时时间(秒)，默认 10 分钟
            poll_interval: 轮询间隔(秒)
            
        Returns:
            TranscriptionTask: 最终任务结果
        """
        start_time = time.time()
        
        while time.time() - start_time < timeout:
            task = await self.get_task_status(task_id)
            
            if task.status in ["SUCCEEDED", "FAILED"]:
                return task
            
            await asyncio.sleep(poll_interval)
        
        # 超时
        return TranscriptionTask(
            task_id=task_id,
            status="TIMEOUT",
            error_message=f"任务执行超时({timeout}秒)"
        )
    
    async def transcribe_and_wait(
        self,
        file_url: str,
        is_video: bool = False,
        language: str = "zh-CN",
        timeout: int = 600,
        extract_points: bool = True  # 新增：是否提炼观点
    ) -> Dict[str, Any]:
        """
        提交转写并等待完成(一站式方法)
        
        Args:
            file_url: 文件 URL(音频或视频)
            is_video: 是否为视频
            language: 语言代码
            timeout: 超时时间(秒)
            extract_points: 是否需要观点提炼
            
        Returns:
            Dict: 转写结果(包含观点提炼)
        """
        # 提交任务
        if is_video:
            task = await self.transcribe_video(file_url, language)
        else:
            task = await self.transcribe_audio(file_url, language)
        
        if task.status == "FAILED":
            return {
                "success": False,
                "error": task.error_message
            }
        
        # 等待完成
        result = await self.wait_for_completion(task.task_id, timeout)
        
        if result.status == "SUCCEEDED":
            response = {
                "success": True,
                "text": result.text,
                "task_id": result.task_id,
                "provider_id": result.provider_id
            }
            
            # 点缀提炼
            if extract_points:
                points_result = await self._extract_points(result.text)
                response["points"] = points_result.get("bullet_points", "")
                response["points_success"] = points_result.get("success", False)
            
            return response
        else:
            return {
                "success": False,
                "error": result.error_message or f"任务状态：{result.status}"
            }
    
    async def transcribe_streamlined(
        self,
        tikhub_play_addr: str,
        language: str = "zh-CN",
        timeout: int = 600,
        extract_points: bool = True,
        use_tikhub_direct: bool = True  # 新增：是否使用 TikHub 直连
    ) -> Dict[str, Any]:
        """
        优化版流程：TikHub 直连百炼 + 智能兜底
        
        Args:
            tikhub_play_addr: TikHub 解析的 play_addr
            language: 语言代码
            timeout: 超时时间(秒)
            extract_points: 是否需要观点提炼
            use_tikhub_direct: 是否使用 TikHub 直连(否则走兜底 OSS 路径)
            
        Returns:
            Dict: 转写结果
        """
        # 1️⃣ URL 有效性预检查 (HEAD 请求)
        if not await self._validate_url(tikhub_play_addr):
            return {
                "success": False,
                "error": "TikHub URL 无效(HEAD 请求失败)",
                "strategy": "fallback"
            }
        
        try:
            # 2️⃣ 百炼直连识别 (主路径)
            task = await self._execute_with_retry(
                self._transcribe_audio_internal,
                audio_url=tikhub_play_addr,
                language=language,
                use_fallback=False  # 主模型 (qwen3-asr-flash-filetrans)
            )
            
            if task.status == "FAILED":
                # 3️⃣ 智能兜底触发
                if "format" in (task.error_message or "").lower():
                    return self._fallback_to_path_one(
                        tikhub_play_addr,
                        language=language,
                        timeout=timeout,
                        extract_points=extract_points
                    )
                return {
                    "success": False,
                    "error": task.error_message,
                    "strategy": "path_two_failed"
                }
            
            # 4️⃣ 等待完成
            result = await self.wait_for_completion(task.task_id, timeout)
            
            if result.status == "SUCCEEDED":
                response = {
                    "success": True,
                    "text": result.text,
                    "task_id": result.task_id,
                    "provider_id": result.provider_id,
                    "strategy": "path_two_direct"
                }
                
                # 5️⃣ 观点提炼
                if extract_points:
                    points_result = await self._extract_points(result.text)
                    response["points"] = points_result.get("bullet_points", "")
                    response["points_success"] = points_result.get("success", False)
                
                return response
            else:
                # 6️⃣ 失败兜底
                return self._fallback_to_path_one(
                    tikhub_play_addr,
                    language=language,
                    timeout=timeout,
                    extract_points=extract_points
                )
                
        except Exception as e:
            # 7️⃣ 异常兜底
            return self._fallback_to_path_one(
                tikhub_play_addr,
                language=language,
                timeout=timeout,
                extract_points=extract_points
            )
    
    def get_health_status(self) -> Dict[str, Any]:
        """
        获取健康状态
        
        Returns:
            Dict: 健康状态信息
        """
        bailian_status = self.router.get_health_status("bailian")
        
        if not bailian_status:
            return {"healthy": False, "error": "Provider not registered"}
        
        return {
            "healthy": bailian_status.healthy,
            "consecutive_failures": bailian_status.consecutive_failures,
            "success_rate": bailian_status.success_rate,
            "avg_response_time_ms": bailian_status.avg_response_time_ms,
            "total_requests": bailian_status.total_requests,
            "failed_requests": bailian_status.failed_requests,
            "last_check_at": bailian_status.last_check_at
        }
    
    def get_router_stats(self) -> Dict[str, Any]:
        """
        获取路由器统计信息
        
        Returns:
            Dict: 统计信息
        """
        return self.router.get_stats()


# ============== 备选实现：使用 DashScope SDK ==============

class BailianClientSDK:
    """使用官方 DashScope SDK 的客户端"""
    
    def __init__(self, api_key: Optional[str] = None):
        """
        初始化 SDK 客户端
        
        Args:
            api_key: API Key
        """
        try:
# Fixed empty BailianClientSDK class
        Returns:
            Dict: 转写结果
        """
        if not self.sdk_available:
            raise ImportError("DashScope SDK 未安装，请使用 BailianClient")
        
        from dashscope import AudioTranscription
        
        try:
            # 提交任务
            task = AudioTranscription.submit(
                model="paraformer-realtime-v2",
                input={"file_url": audio_url}
            )
            
            # 等待完成
            result = AudioTranscription.wait(task=task)
            
            if result.status_code == 200:
                return {
                    "success": True,
                    "text": result.output.get("text", "")
                }
            else:
                return {
                    "success": False,
                    "error": result.message
                }
                
        except Exception as e:
            return {
                "success": False,
                "error": str(e)
            }


# ============== 单例实例 ==============

_client_instance: Optional[BailianClient] = None


def get_bailian_client() -> BailianClient:
    """
    获取百炼客户端实例(单例)
    
    Returns:
        BailianClient: 客户端实例
    """
    global _client_instance
    if _client_instance is None:
        _client_instance = BailianClient()
    return _client_instance


def reset_bailian_client() -> None:
    """重置客户端实例(用于测试)"""
    global _client_instance
    _client_instance = None
