{
  "dashboard": {
    "id": null,
    "uid": "jieyue-securities",
    "title": "捷阅证券信息助手 - 监控仪表板",
    "tags": ["jieyue", "securities"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "graph",
        "title": "API 请求率",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"backend\"}[5m])",
            "legendFormat": "{{method}} {{path}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "请求/秒", "show": true},
          {"show": true}
        ],
        "xaxis": {"show": true, "mode": "time"},
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 2,
        "points": false,
        "bars": false,
        "stack": false,
        "percentage": false,
        "legend": {"show": true, "values": false, "min": false, "max": false, "current": false, "total": false, "avg": false}
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "graph",
        "title": "API 响应时间",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m]))",
            "legendFormat": "P95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"backend\"}[5m]))",
            "legendFormat": "P50",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"label": "秒", "show": true},
          {"show": true}
        ],
        "xaxis": {"show": true, "mode": "time"},
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "graph",
        "title": "错误率",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"backend\",status=~\"5..\"}[5m])",
            "legendFormat": "5xx 错误",
            "refId": "A"
          },
          {
            "expr": "rate(http_requests_total{job=\"backend\",status=~\"4..\"}[5m])",
            "legendFormat": "4xx 错误",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"label": "错误/秒", "show": true},
          {"show": true}
        ],
        "xaxis": {"show": true, "mode": "time"},
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "singlestat",
        "title": "API 可用性",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"backend\",status=~\"2..\"}[5m])) / sum(rate(http_requests_total{job=\"backend\"}[5m])) * 100",
            "legendFormat": "可用性 %",
            "refId": "A"
          }
        ],
        "format": "percent",
        "prefix": "",
        "postfix": "",
        "valueName": "current",
        "colorBackground": true,
        "thresholds": "90,95,99",
        "colors": ["#d44a3a", "#efa24c", "#299c46"]
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
        "type": "graph",
        "title": "MySQL 连接数",
        "targets": [
          {
            "expr": "mysql_global_status_threads_connected",
            "legendFormat": "连接数",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "连接数", "show": true},
          {"show": true}
        ],
        "xaxis": {"show": true, "mode": "time"},
        "lines": true,
        "fill": 1
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
        "type": "graph",
        "title": "Redis 内存使用",
        "targets": [
          {
            "expr": "redis_memory_used_bytes",
            "legendFormat": "已用内存",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "字节", "show": true},
          {"show": true}
        ],
        "xaxis": {"show": true, "mode": "time"},
        "lines": true,
        "fill": 1
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
        "type": "graph",
        "title": "系统 CPU 使用率",
        "targets": [
          {
            "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU {{instance}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "%", "show": true, "min": 0, "max": 100},
          {"show": true}
        ],
        "xaxis": {"show": true, "mode": "time"},
        "lines": true,
        "fill": 1
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  },
  "overwrite": true
}
