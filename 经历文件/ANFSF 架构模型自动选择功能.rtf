class DualLayerModelRouter \{\
  selectModel(stage: 'inline_guard' | 'external_review'): string \{\
    if (stage === 'inline_guard') \{\
      // Inline Guard: \uc0\u20302 \u24310 \u36831 \u27169 \u22411  (<10ms)\
      return 'qwen-turbo';\
    \} else \{\
      // External Review: \uc0\u39640 \u31934 \u24230 \u27169 \u22411 \
      return 'qwen-max';\
    \}\
  \}\
\}\
