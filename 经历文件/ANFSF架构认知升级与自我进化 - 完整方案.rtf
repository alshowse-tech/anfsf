### 3.1 \uc0\u32500 \u24230 1\u65306 \u36923 \u36753 \u24615 \u65288 P0\u65292 \u33258 \u21160 \u25191 \u34892 \u65289 \
\
```typescript\
// why-what-how-reasoner.ts\
export class WhyWhatHowReasoner \{\
  async analyze(requirement: string): Promise<ReasoningResult> \{\
    // \uc0\u31532 \u19968 \u23618 \u65306 \u20026 \u20160 \u20040 \u20570 \u65288 5Whys\u36861 \u38382 \u26412 \u36136 \u65289 \
    const why = await this.askWhy(requirement);\
    \
    // \uc0\u31532 \u20108 \u23618 \u65306 \u20570 \u20160 \u20040 \u65288 \u23450 \u20041 \u30446 \u26631 \u65289 \
    const what = await this.defineWhat(why);\
    \
    // \uc0\u31532 \u19977 \u23618 \u65306 \u24590 \u20040 \u20570 \u65288 \u35774 \u35745 \u36335 \u24452 \u12289 \u35780 \u20272 \u36873 \u25321 \u65289 \
    const how = await this.designHow(what);\
    \
    return \{ why, what, how, reasoningChain: this.buildChain(why, what, how) \};\
  \}\
  \
  private async askWhy(requirement: string): Promise<WhyResult> \{\
    let current = requirement;\
    const chain = [];\
    \
    for (let i = 0; i < 5; i++) \{\
      const next = await this.model.ask(`\uc0\u36861 \u38382 "$\{current\}"\u30340 \u26681 \u26412 \u21407 \u22240 \u26159 \u20160 \u20040 \u65311 `);\
      chain.push(next);\
      if (this.isRootCause(next)) break;\
      current = next;\
    \}\
    \
    return \{ rootCause: chain[chain.length - 1], chain \};\
  \}\
\}\
```\
