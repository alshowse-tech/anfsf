    // 1. \uc0\u35782 \u21035 \u23457 \u25209 \u27969 \u27169 \u24335 \
    const approvalMatches = projectLog.match(this.patterns.approval_flow.regex);\
    if (approvalMatches && approvalMatches.length > 0) \{\
