// skills/knowledge-validator.ts\
export class KnowledgeValidator \{\
  async validate(knowledgeItems: any[]): Promise<any[]> \{\
    const validated = [];\
    \
    for (const item of knowledgeItems) \{\
      // 1. \uc0\u22522 \u26412 \u32467 \u26500 \u39564 \u35777 \
      if (!item.title || !item.content || !item.source) \{\
        console.warn(`\uc0\u30693 \u35782 \u39564 \u35777 \u22833 \u36133 : \u32570 \u23569 \u24517 \u35201 \u23383 \u27573 `, item);\
        continue;\
      \}\
      \
      // 2. \uc0\u20869 \u23481 \u38271 \u24230 \u39564 \u35777 \
      if (item.content.length < 50) \{\
        console.warn(`\uc0\u30693 \u35782 \u39564 \u35777 \u22833 \u36133 : \u20869 \u23481 \u36807 \u30701 `, item.title);\
        continue;\
      \}\
      \
      // 3. \uc0\u26102 \u25928 \u24615 \u39564 \u35777 \u65288 30\u22825 \u20869 \u65289 \
      const timestamp = new Date(item.timestamp);\
      const daysOld = (Date.now() - timestamp.getTime()) / (1000 * 60 * 60 * 24);\
      if (daysOld > 30) \{\
        console.warn(`\uc0\u30693 \u35782 \u39564 \u35777 \u22833 \u36133 : \u36229 \u36807 30\u22825 `, item.title);\
        continue;\
      \}\
      \
      validated.push(item);\
    \}\
    \
    return validated;\
  \}\
\}\
