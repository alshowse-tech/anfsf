    approval_flow: \{\
      keywords: ['\uc0\u23457 \u25209 ', '\u25209 \u20934 ', '\u23457 \u26680 ', '\u39539 \u22238 ', '\u36890 \u36807 ', '\u29366 \u24577 \u26426 ', '\u24037 \u20316 \u27969 '],\
