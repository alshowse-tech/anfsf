          count: departments.length,\
          description: '\uc0\u26816 \u27979 \u21040 \u36328 \u37096 \u38376 \u21327 \u20316 \u27969 \u31243 '\
        \},\
        confidence: Math.min(0.75 + departments.length * 0.05, 0.95)\
      \});\
    \}\
    \
    // 3. \uc0\u35782 \u21035 \u25253 \u34920 \u27169 \u26495 \u27169 \u24335 \
    const reportMatches = projectLog.match(this.patterns.report_template.regex);\
    if (reportMatches && reportMatches.length > 0) \{\
      insights.push(\{\
        type: 'report_template',\
        content: \{\
          detectedFeatures: reportMatches,\
          count: reportMatches.length,\
          description: '\uc0\u26816 \u27979 \u21040 \u22797 \u26434 \u25253 \u34920 \u38656 \u27714 '\
        \},\
        confidence: Math.min(0.7 + reportMatches.length * 0.03, 0.95)\
      \});\
    \}\
    \
    return insights;\
  \}\
  \
  private extractDepartments(log: string): string[] \{\
    const depts: string[] = [];\
    const deptList = ['\uc0\u25237 \u36164 \u31649 \u29702 \u37096 ', '\u24037 \u31243 \u37096 ', '\u23457 \u35745 \u37096 ', '\u36130 \u21153 \u37096 ', '\u35745 \u21010 \u37096 '];\
