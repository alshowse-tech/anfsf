\}\
\
export class MCPBus \{\
  private idempotencyStore: Map<string, MCPResponse> = new Map()\
  \
  async send(message: MCPMessage): Promise<MCPResponse> \{\
    // \uc0\u24130 \u31561 \u26816 \u26597 \
    if (message.idempotentKey && this.idempotencyStore.has(message.idempotentKey)) \{\
      return this.idempotencyStore.get(message.idempotentKey)!\
