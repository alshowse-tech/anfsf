// skills-registry.ts (\uc0\u26368 \u32456 \u29256 )\
export class SkillsRegistry \{\
  private skills: Map<string, Skill> = new Map()\
  private dependencyGraph: Map<string, Set<string>> = new Map()\
  \
  async load(skillName: string, version: string): Promise<Skill> \{\
    const key = `$\{skillName\}@$\{version\}`\
    \
    // 1. \uc0\u26816 \u26597 \u20381 \u36182 \u25299 \u25169 \u65288 \u38450 \u27490 \u24490 \u29615 \u20381 \u36182 \u65289 \
    const dependencies = await this.getDependencies(skillName, version)\
    if (this.hasCycle(skillName, dependencies)) \{\
      throw new Error(`Circular dependency detected for skill: $\{key\}`)\
    \}\
    \
    // 2. \uc0\u21152 \u36733 \u25216 \u33021 \u65288 \u27801 \u31665 \u25191 \u34892 \u65289 \
    const skill = await this.loadWithSandbox(skillName, version)\
    this.skills.set(key, skill)\
    \
    // 3. \uc0\u35760 \u24405 \u20381 \u36182 \u20851 \u31995 \
    this.dependencyGraph.set(key, new Set(dependencies))\
    \
    return skill\
  \}\
  \
  private async loadWithSandbox(skillName: string, version: string): Promise<Skill> \{\
    const sandbox = new SandboxExecutor(\{\
      memoryLimit: 256,\
      timeLimit: 30000,\
      allowedPaths: ['skills:/**']\
    \})\
    \
    const skillCode = await this.graphRAG.retrieveSkillCode(skillName, version)\
    const result = await sandbox.execute(skillCode, \{ skillName, version \})ANFSF\
    \
    return result.output as Skill\
  \}\
  \
  private hasCycle(skillName: string, dependencies: string[], visited: Set<string> = new Set()): boolean \{\
    if (visited.has(skillName)) return true\
    visited.add(skillName)\
    \
    for (const dep of dependencies) \{\
      const subDeps = this.getCachedDependencies(dep)\
      if (this.hasCycle(dep, subDeps, visited)) return true\
    \}\
    \
    visited.delete(skillName)\
    return false\
  \}\
\}\
```\
