// harness.ts (\uc0\u26368 \u32456 \u29256 )\
export class AgentHarness \{\
  private ownershipLattice: OwnershipLattice\
  private personalizationBudget: PersonalizationBudgetController\
  private significanceThreshold = 0.05  // \uc0\u21487 \u37197 \u32622 \
  \
  async runTest(scenario: TestScenario): Promise<TestResult> \{\
    // \uc0\u25152 \u26377 \u26435 \u20210 \u35009 \u65288 \u26032 \u22686 \u65289 \
    const authCheck = await this.ownershipLattice.check(\{\
      action: 'harness_test',\
      resource: `test:$\{scenario\}`,\
      role: 'QA'\
    \})\
    \
    if (!authCheck.granted) \{\
      return \{\
        passed: false,\
        error: `Permission denied: $\{authCheck.rule\}`,\
        requiresApproval: true\
      \}\
    \}\
    \
    switch (scenario) \{\
      case 'personalization':\
        return this.runPersonalizationABTest()\
      // ... \uc0\u20854 \u20182 \u22330 \u26223 \
    \}\
  \}\
  \
  private async runPersonalizationABTest(): Promise<TestResult> \{\
    // 1. \uc0\u21019 \u24314 \u20004 \u32452 \u29992 \u25143 \
    const groupA = await this.createUserGroup('control')\
    const groupB = await this.createUserGroup('variant')\
    \
    // 2. \uc0\u27979 \u37327 \u20307 \u39564 \u25351 \u26631 \
    const metricsA = await this.measureExperience(groupA)\
    const metricsB = await this.measureExperience(groupB)\
    \
    // 3. \uc0\u32479 \u35745 \u26174 \u33879 \u24615 \u26816 \u39564 \u65288 \u21487 \u37197 \u32622 \u38408 \u20540 \u65289 \
    const pValue = this.calculatePValue(metricsA, metricsB)\
    const significant = pValue < this.significanceThreshold\
    \
    // 4. \uc0\u26816 \u26597 \u20010 \u24615 \u21270 \u39044 \u31639 \u65288 \u19982 PersonalizationBudgetController\u32852 \u21160 \u65289 \
    const delta = Math.abs(metricsB.personalizationDelta - metricsA.personalizationDelta)\
    const budgetCheck = await this.personalizationBudget.checkDelta(delta)\
    \
    if (!budgetCheck.passed) \{\
      return \{\
        passed: false,\
        error: `Personalization delta $\{delta\} exceeds budget`,\
        suggestion: 'reduce_delta_or_increase_budget'\
      \}\
    \}\
    \
    return \{\
      passed: significant,\
      metrics: \{ pValue, delta \},\
      total: 2,\
      failed: significant ? 0 : 1,\
      failures: significant ? [] : [`Personalization variant not statistically better (p=$\{pValue.toFixed(4)\})`]\
    \}\
  \}\
  \
  async deployWithCanary(\
    newPolicy: Policy,\
    options: \{\
      steps?: number[]\
      requireOwnership?: boolean\
      autoRollback?: boolean\
    \} = \{\}\
  ): Promise<DeploymentResult> \{\
    const steps = options.steps || [0.01, 0.05, 0.2, 0.5, 1.0]\
    \
    // \uc0\u25152 \u26377 \u26435 \u20210 \u35009 \u65288 \u26032 \u22686 \u65289 \
    if (options.requireOwnership !== false) \{\
      const authCheck = await this.ownershipLattice.check(\{\
        action: 'deploy_canary',\
        resource: `policy:$\{newPolicy.id\}`,\
        role: 'ARCH'\
      \})\
      if (!authCheck.granted) \{\
        return \{ success: false, error: `Deployment requires ARCH approval` \}\
      \}\
    \}\
    \
    // ... \uc0\u37329 \u19997 \u38592 \u37096 \u32626 \u36923 \u36753 \
  \}\
\}\
