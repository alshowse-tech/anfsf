    if (accuracy < 0.6) \{\
      console.warn(`\uc0\u9888 \u65039  $\{type\}\u31867 \u22411 \u34917 \u20840 \u20934 \u30830 \u29575 \u36807 \u20302 ($\{(accuracy * 100).toFixed(0)\}%)\u65292 \u24314 \u35758 \u26242 \u20572 \u33258 \u21160 \u34917 \u20840 `);\
    \}\
  \}\
  \
  private async optimizeKnowledgeBase(): Promise<void> \{\
    // 1. \uc0\u20998 \u26512 \u25509 \u21463 \u29575 \
    const acceptanceRates = await this.calculateAcceptanceRates();\
    \
    // 2. \uc0\u25552 \u21462 \u26032 \u27169 \u24335 \u65288 \u20174 \u29992 \u25143 \u20462 \u25913 \u20013 \u23398 \u20064 \u65289 \
