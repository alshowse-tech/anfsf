// \uc0\u25991 \u20214 \u65306 src/skills/confidence-calculator.ts\
\
export interface ConfidenceContext \{\
  prd: string;\
  industry: string;\
  historicalAccuracy?: number;\
\}\
\
export class ConfidenceCalculator \{\
  // \uc0\u21382 \u21490 \u20934 \u30830 \u29575 \u32531 \u23384 \
  private historicalAccuracy: Map<string, number> = new Map();\
  \
  calculate(completion: Completion, context: ConfidenceContext): number \{\
    let confidence = 0;\
    \
    // 1. \uc0\u30693 \u35782 \u24211 \u21305 \u37197 \u24230 \u65288 40%\u26435 \u37325 \u65289 \
    const knowledgeMatch = this.getKnowledgeMatchScore(completion);\
    confidence += knowledgeMatch * 0.4;\
    \
    // 2. \uc0\u21382 \u21490 \u20934 \u30830 \u29575 \u65288 30%\u26435 \u37325 \u65289 \
    const historicalAccuracy = this.getHistoricalAccuracy(completion.type, context.industry);\
    confidence += historicalAccuracy * 0.3;\
    \
    // 3. \uc0\u35268 \u21017 \u30830 \u23450 \u24615 \u65288 20%\u26435 \u37325 \u65289 \
    const ruleCertainty = this.getRuleCertainty(completion);\
    confidence += ruleCertainty * 0.2;\
    \
    // 4. \uc0\u19978 \u19979 \u25991 \u19968 \u33268 \u24615 \u65288 10%\u26435 \u37325 \u65289 \
    const contextConsistency = this.checkContextConsistency(completion, context.prd);\
    confidence += contextConsistency * 0.1;\
    \
    return Math.min(confidence, 1.0);\
  \}\
  \
  private getKnowledgeMatchScore(completion: Completion): number \{\
    // \uc0\u22522 \u20110 \u30693 \u35782 \u24211 \u21305 \u37197 \u24230 \u36820 \u22238 \u20998 \u25968 \
    switch (completion.type) \{\
      case 'org_structure':\
        return 0.95;  // \uc0\u32452 \u32455 \u26550 \u26500 \u27169 \u26495 \u21305 \u37197 \u24230 \u39640 \
      case 'field':\
        return 0.90;  // \uc0\u23383 \u27573 \u26631 \u20934 \u21305 \u37197 \u24230 \u39640 \
      case 'query':\
        return 0.85;  // \uc0\u26597 \u35810 \u27169 \u26495 \u21305 \u37197 \u24230 \u20013 \u39640 \
      case 'permission':\
        return 0.80;  // \uc0\u26435 \u38480 \u27169 \u22411 \u21305 \u37197 \u24230 \u20013 \
      case 'flow':\
        return 0.75;  // \uc0\u27969 \u31243 \u27169 \u24335 \u21305 \u37197 \u24230 \u20013 \
      default:\
        return 0.70;\
    \}\
  \}\
  \
  private getHistoricalAccuracy(type: string, industry: string): number \{\
    const key = `$\{industry\}_$\{type\}`;\
    return this.historicalAccuracy.get(key) || 0.75;  // \uc0\u40664 \u35748 75%\
  \}\
  \
  private getRuleCertainty(completion: Completion): number \{\
    // \uc0\u22522 \u20110 \u35268 \u21017 \u30830 \u23450 \u24615 \u36820 \u22238 \u20998 \u25968 \
    if (completion.content && Array.isArray(completion.content) && completion.content.length > 0) \{\
      return 0.90;\
    \}\
    return 0.70;\
  \}\
  \
  private checkContextConsistency(completion: Completion, prd: string): number \{\
    // \uc0\u26816 \u26597 \u34917 \u20840 \u20869 \u23481 \u19982 PRD\u19978 \u19979 \u25991 \u30340 \u19968 \u33268 \u24615 \
    // \uc0\u31616 \u21270 \u23454 \u29616 \u65306 \u26816 \u26597 \u26159 \u21542 \u26377 \u26126 \u26174 \u20914 \u31361 \
    if (completion.type === 'permission') \{\
      const roles = completion.content.map(r => r.name);\
      for (const role of roles) \{\
        if (prd.includes(`\uc0\u19981 \u38656 \u35201 $\{role\}`) || prd.includes(`\u26080 $\{role\}`)) \{\
          return 0.3;  // \uc0\u23384 \u22312 \u20914 \u31361 \u65292 \u32622 \u20449 \u24230 \u20302 \
        \}\
      \}\
    \}\
    return 0.85;\
  \}\
  \
  // \uc0\u26356 \u26032 \u21382 \u21490 \u20934 \u30830 \u29575 \u65288 \u30001 \u21453 \u39304 \u38381 \u29615 \u35843 \u29992 \u65289 \
  updateHistoricalAccuracy(type: string, industry: string, accuracy: number): void \{\
    const key = `$\{industry\}_$\{type\}`;\
    this.historicalAccuracy.set(key, accuracy);\
  \}\
\}\
