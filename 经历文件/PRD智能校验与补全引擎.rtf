    \}\
  \}\
  \
  private async updateAccuracyMetrics(type: string): Promise<void> \{\
    const typeRecords = this.feedbackStore.filter(r => r.type === type);\
    const acceptedCount = typeRecords.filter(r => r.action === 'accept').length;\
    const accuracy = acceptedCount / typeRecords.length;\
    \
    // \uc0\u26356 \u26032 \u32622 \u20449 \u24230 \u35745 \u31639 \u22120 \u30340 \u21382 \u21490 \u20934 \u30830 \u29575 \
