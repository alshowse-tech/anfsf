import express from 'express';\
import \{ Server \} from 'http';\
\
export class RequirementRefinerSkill extends Skill \{\
  private confirmationServer: Server | null = null;\
  private confirmationPort = 3456;\
  \
  private async launchConfirmationUI(result: CompletionResult): Promise<boolean> \{\
    // \uc0\u21551 \u21160 HTTP\u26381 \u21153 \u22120 \
    const app = express();\
    \
    // \uc0\u20013 \u38388 \u20214 \u37197 \u32622 \
    app.use(express.json());\
    app.use(express.static(path.join(__dirname, '../ui')));  // \uc0\u38745 \u24577 \u25991 \u20214 \u30446 \u24405 \
    \
    // API\uc0\u36335 \u30001 \
    app.get('/api/prd/completions', (req, res) => \{\
      res.json(this.formatCompletionsForUI(result));\
    \});\
    \
    app.post('/api/prd/accept', async (req, res) => \{\
      const \{ completionId \} = req.body;\
      await this.feedbackLoop.recordFeedback(\{\
        completionId,\
        action: 'accept',\
        timestamp: new Date()\
      \});\
      res.json(\{ success: true \});\
    \});\
    \
    app.post('/api/prd/reject', async (req, res) => \{\
      const \{ completionId \} = req.body;\
      await this.feedbackLoop.recordFeedback(\{\
        completionId,\
        action: 'reject',\
        timestamp: new Date()\
      \});\
      res.json(\{ success: true \});\
    \});\
    \
    app.post('/api/prd/modify', async (req, res) => \{\
      const \{ completionId, modifiedValue \} = req.body;\
      await this.feedbackLoop.recordFeedback(\{\
        completionId,\
        action: 'modify',\
        modifiedValue,\
        timestamp: new Date()\
      \});\
      res.json(\{ success: true \});\
    \});\
    \
    app.post('/api/prd/confirm', (req, res) => \{\
      res.json(\{ success: true \});\
    \});\
    \
    // \uc0\u21551 \u21160 \u26381 \u21153 \u22120 \
    return new Promise((resolve) => \{\
      this.confirmationServer = app.listen(this.confirmationPort, () => \{\
        console.log(`\uc0\u55357 \u56523  PRD\u30830 \u35748 \u30028 \u38754 \u24050 \u21551 \u21160 : http://localhost:$\{this.confirmationPort\}`);\
        console.log('   \uc0\u35831 \u22312 \u27983 \u35272 \u22120 \u20013 \u25171 \u24320 \u19978 \u36848 \u22320 \u22336 \u65292 \u30830 \u35748 \u34917 \u20840 \u24314 \u35758 \u21518 \u32487 \u32493 ');\
        \
        // \uc0\u21487 \u36873 \u65306 \u33258 \u21160 \u25171 \u24320 \u27983 \u35272 \u22120 \
        const \{ exec \} = require('child_process');\
        exec(`open http://localhost:$\{this.confirmationPort\}`);  // macOS\
        // exec(`start http://localhost:$\{this.confirmationPort\}`);  // Windows\
        // exec(`xdg-open http://localhost:$\{this.confirmationPort\}`);  // Linux\
        \
        // \uc0\u31561 \u24453 \u30830 \u35748 \u65288 \u31616 \u21270 \u23454 \u29616 \u65292 \u29983 \u20135 \u29615 \u22659 \u24212 \u20351 \u29992 WebSocket\u65289 \
        this.waitForConfirmation().then(resolve);\
      \});\
    \});\
  \}\
  \
  private waitForConfirmation(): Promise<boolean> \{\
    return new Promise((resolve) => \{\
      // \uc0\u26041 \u26696 1\u65306 \u31561 \u24453 \u29992 \u25143 \u28857 \u20987 \u30830 \u35748 \u25353 \u38062 \u65288 \u36890 \u36807 API\u22238 \u35843 \u65289 \
      // \uc0\u36825 \u37324 \u31616 \u21270 \u65306 \u31561 \u24453 30\u31186 \u21518 \u33258 \u21160 \u30830 \u35748 \
      // \uc0\u29983 \u20135 \u29615 \u22659 \u24212 \u20351 \u29992 WebSocket\u30417 \u21548 \u30830 \u35748 \u20107 \u20214 \
      setTimeout(() => \{\
        this.closeConfirmationServer();\
        resolve(true);\
      \}, 300000); // 5\uc0\u20998 \u38047 \u36229 \u26102 \
    \});\
  \}\
  \
  private closeConfirmationServer(): void \{\
    if (this.confirmationServer) \{\
      this.confirmationServer.close();\
