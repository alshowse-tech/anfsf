### 3.3 PRD\uc0\u34917 \u20840 \u24341 \u25806 \u23454 \u29616 \
\
```typescript\
// \uc0\u25991 \u20214 \u65306 src/skills/prd-completion-engine.ts\
\
import \{ DomainKnowledgeBase \} from '../knowledge/domain-knowledge-base';\
import \{ ConfidenceCalculator \} from './confidence-calculator';\
\
export interface CompletionResult \{\
  originalPrd: string;\
  completedPrd: string;\
  completions: Completion[];\
  confidence: number;\
  needsReview: Completion[];\
\}\
\
export interface Completion \{\
  id: string;\
  type: 'org_structure' | 'permission' | 'flow' | 'field' | 'query' | 'template';\
  content: any;\
  confidence: number;\
  displayType: 'tree' | 'table' | 'flow' | 'text';\
  suggestion: string;\
  location?: \{\
    section: string;\
    line?: number;\
  \};\
\}\
\
export class PRDCompletionEngine \{\
  private knowledgeBase: DomainKnowledgeBase;\
  private confidenceCalculator: ConfidenceCalculator;\
  \
  constructor(knowledgeBase: DomainKnowledgeBase) \{\
    this.knowledgeBase = knowledgeBase;\
    this.confidenceCalculator = new ConfidenceCalculator();\
  \}\
  \
  async complete(prd: string, industry: string): Promise<CompletionResult> \{\
    const completions: Completion[] = [];\
    \
    // 1. \uc0\u32452 \u32455 \u26550 \u26500 \u34917 \u20840 \
    const orgCompletions = await this.completeOrgStructure(prd, industry);\
    completions.push(...orgCompletions);\
    \
    // 2. \uc0\u26435 \u38480 \u27169 \u22411 \u34917 \u20840 \
    const permissionCompletions = await this.completePermissions(prd, industry);\
    completions.push(...permissionCompletions);\
    \
    // 3. \uc0\u27969 \u31243 \u34917 \u20840 \
    const flowCompletions = await this.completeFlows(prd);\
    completions.push(...flowCompletions);\
    \
    // 4. \uc0\u23383 \u27573 \u34917 \u20840 \
    const fieldCompletions = await this.completeFields(prd);\
    completions.push(...fieldCompletions);\
    \
    // 5. \uc0\u26597 \u35810 \u26465 \u20214 \u34917 \u20840 \
    const queryCompletions = await this.completeQueries(prd);\
    completions.push(...queryCompletions);\
    \
    // 6. \uc0\u21382 \u21490 \u27169 \u26495 \u21305 \u37197 \
    const templateCompletions = await this.matchHistoricalTemplate(prd);\
    completions.push(...templateCompletions);\
    \
    // \uc0\u35745 \u31639 \u32622 \u20449 \u24230 \
    for (const completion of completions) \{\
      completion.confidence = this.confidenceCalculator.calculate(completion, \{ prd, industry \});\
    \}\
    \
    // \uc0\u20998 \u31163 \u38656 \u35201 \u20154 \u24037 \u30830 \u35748 \u30340 \u34917 \u20840 \u65288 \u32622 \u20449 \u24230 <85%\u65289 \
    const needsReview = completions.filter(c => c.confidence < 0.85);\
    const autoApply = completions.filter(c => c.confidence >= 0.85);\
    \
    // \uc0\u24212 \u29992 \u33258 \u21160 \u34917 \u20840 \
    let completedPrd = prd;\
    for (const completion of autoApply) \{\
      completedPrd = this.applyCompletion(completedPrd, completion);\
    \}\
    \
    const overallConfidence = completions.length > 0 \
      ? completions.reduce((sum, c) => sum + c.confidence, 0) / completions.length\
      : 1;\
    \
    return \{\
      originalPrd: prd,\
      completedPrd,\
      completions,\
      confidence: overallConfidence,\
      needsReview\
    \};\
  \}\
  \
  private async completeOrgStructure(prd: string, industry: string): Promise<Completion[]> \{\
    const template = this.knowledgeBase.orgStructures.find(o => o.industry === industry);\
    if (!template) return [];\
    \
    // \uc0\u26816 \u27979 PRD\u20013 \u26159 \u21542 \u24050 \u26377 \u32452 \u32455 \u26550 \u26500 \u25551 \u36848 \
    const hasOrg = this.hasOrgStructure(prd);\
    if (hasOrg) return [];\
    \
    return [\{\
      id: `org_$\{Date.now()\}`,\
      type: 'org_structure',\
      content: template.departments,\
      confidence: 0.85,\
      displayType: 'tree',\
      suggestion: `\uc0\u24314 \u35758 \u34917 \u20805 \u32452 \u32455 \u26550 \u26500 \u65306 $\{template.departments.map(d => d.name).join(' \u8594  ')\}`\
    \}];\
  \}\
  \
  private async completePermissions(prd: string, industry: string): Promise<Completion[]> \{\
    const template = this.knowledgeBase.rolePermissions.find(r => r.industry === industry);\
    if (!template) return [];\
    \
    // \uc0\u25552 \u21462 PRD\u20013 \u25552 \u21040 \u30340 \u35282 \u33394 \
    const mentionedRoles = await this.extractRoles(prd);\
    const missingRoles = template.roles.filter(r => !mentionedRoles.includes(r.name));\
    \
    if (missingRoles.length === 0) return [];\
    \
    return [\{\
      id: `perm_$\{Date.now()\}`,\
      type: 'permission',\
      content: missingRoles,\
      confidence: 0.80,\
      displayType: 'table',\
      suggestion: `\uc0\u24314 \u35758 \u34917 \u20805 \u20197 \u19979 \u35282 \u33394 \u26435 \u38480 \u65306 $\{missingRoles.map(r => r.name).join(', ')\}`\
    \}];\
  \}\
  \
  private async completeFlows(prd: string): Promise<Completion[]> \{\
    // \uc0\u26816 \u27979 PRD\u20013 \u30340 \u27969 \u31243 \u25551 \u36848 \
    const flows = await this.extractFlowDescriptions(prd);\
    const completions: Completion[] = [];\
    \
    for (const flow of flows) \{\
      // \uc0\u21305 \u37197 \u27969 \u31243 \u27169 \u24335 \
      const matchedPattern = this.knowledgeBase.flowPatterns.find(p => \
        flow.description.includes(p.domain) || flow.name.includes(p.name)\
      );\
      \
      if (matchedPattern && !this.hasCompleteFlow(prd, matchedPattern)) \{\
        completions.push(\{\
          id: `flow_$\{Date.now()\}_$\{flow.id\}`,\
          type: 'flow',\
          content: matchedPattern,\
          confidence: 0.75,\
          displayType: 'flow',\
          suggestion: `\uc0\u24314 \u35758 \u34917 \u20805 \u23436 \u25972 \u30340 $\{matchedPattern.name\}\u27969 \u31243 `,\
          location: \{ section: flow.section \}\
        \});\
      \}\
    \}\
    \
    return completions;\
  \}\
  \
  private async completeFields(prd: string): Promise<Completion[]> \{\
    // \uc0\u25552 \u21462 PRD\u20013 \u30340 \u23454 \u20307 \
    const entities = await this.extractEntities(prd);\
    const completions: Completion[] = [];\
    \
    for (const entity of entities) \{\
      const standard = this.knowledgeBase.fieldStandards.find(s => s.entityType === entity.type);\
      if (!standard) continue;\
      \
      const existingFields = await this.extractFields(prd, entity.name);\
      const missingFields = standard.requiredFields.filter(f => !existingFields.includes(f.name));\
      \
      if (missingFields.length > 0) \{\
        completions.push(\{\
          id: `field_$\{Date.now()\}_$\{entity.id\}`,\
          type: 'field',\
          content: missingFields,\
          confidence: 0.90,\
          displayType: 'table',\
          suggestion: `\uc0\u24314 \u35758 \u20026 \u23454 \u20307 "$\{entity.name\}"\u34917 \u20805 \u23383 \u27573 \u65306 $\{missingFields.map(f => f.name).join(', ')\}`,\
          location: \{ section: entity.section \}\
        \});\
      \}\
    \}\
    \
    return completions;\
  \}\
  \
  private async completeQueries(prd: string): Promise<Completion[]> \{\
    // \uc0\u26816 \u27979 PRD\u20013 \u30340 \u26597 \u35810 \u22330 \u26223 \
    const scenes = await this.extractQueryScenes(prd);\
    const completions: Completion[] = [];\
    \
    for (const scene of scenes) \{\
      const template = this.knowledgeBase.queryTemplates.find(t => t.scene === scene.type);\
      if (template && !this.hasQueryConditions(prd, scene)) \{\
        completions.push(\{\
          id: `query_$\{Date.now()\}_$\{scene.id\}`,\
          type: 'query',\
          content: template.defaultConditions,\
          confidence: 0.85,\
          displayType: 'table',\
          suggestion: `\uc0\u24314 \u35758 \u20026 $\{scene.name\}\u34917 \u20805 \u26597 \u35810 \u26465 \u20214 \u65306 $\{template.defaultConditions.map(c => c.name).join(', ')\}`,\
          location: \{ section: scene.section \}\
        \});\
      \}\
    \}\
    \
    return completions;\
  \}\
  \
  private async matchHistoricalTemplate(prd: string): Promise<Completion[]> \{\
    // \uc0\u22522 \u20110 \u30456 \u20284 \u24230 \u21305 \u37197 \u21382 \u21490 \u27169 \u26495 \
    const similarTemplates = await this.findSimilarTemplates(prd);\
    \
    if (similarTemplates.length === 0) return [];\
    \
    const bestMatch = similarTemplates[0];\
    if (bestMatch.similarity < 0.7) return [];\
    \
    return [\{\
      id: `template_$\{Date.now()\}`,\
      type: 'template',\
      content: bestMatch.template.structure,\
      confidence: bestMatch.similarity,\
      displayType: 'text',\
      suggestion: `\uc0\u26816 \u27979 \u21040 \u19982 \u21382 \u21490 \u39033 \u30446 "$\{bestMatch.template.name\}"\u30456 \u20284 (\u30456 \u20284 \u24230 $\{(bestMatch.similarity * 100).toFixed(0)\}%)\u65292 \u24314 \u35758 \u21442 \u32771 \u20854 PRD\u32467 \u26500 `\
    \}];\
  \}\
  \
  private applyCompletion(prd: string, completion: Completion): string \{\
    // \uc0\u26681 \u25454 \u34917 \u20840 \u31867 \u22411 \u24212 \u29992 \u20462 \u25913 \
    switch (completion.type) \{\
      case 'org_structure':\
        return this.insertOrgStructure(prd, completion.content);\
      case 'permission':\
        return this.insertPermissions(prd, completion.content);\
      case 'flow':\
        return this.insertFlow(prd, completion.content);\
      case 'field':\
        return this.insertFields(prd, completion.content);\
      case 'query':\
        return this.insertQueryConditions(prd, completion.content);\
      default:\
        return prd;\
    \}\
  \}\
  \
  // \uc0\u36741 \u21161 \u26041 \u27861 \
  private hasOrgStructure(prd: string): boolean \{ /* \uc0\u23454 \u29616  */ return false; \}\
  private hasCompleteFlow(prd: string, pattern: FlowPattern): boolean \{ /* \uc0\u23454 \u29616  */ return false; \}\
  private hasQueryConditions(prd: string, scene: any): boolean \{ /* \uc0\u23454 \u29616  */ return false; \}\
  private async extractRoles(prd: string): Promise<string[]> \{ /* \uc0\u23454 \u29616  */ return []; \}\
  private async extractFlowDescriptions(prd: string): Promise<any[]> \{ /* \uc0\u23454 \u29616  */ return []; \}\
  private async extractEntities(prd: string): Promise<any[]> \{ /* \uc0\u23454 \u29616  */ return []; \}\
  private async extractFields(prd: string, entityName: string): Promise<string[]> \{ /* \uc0\u23454 \u29616  */ return []; \}\
  private async extractQueryScenes(prd: string): Promise<any[]> \{ /* \uc0\u23454 \u29616  */ return []; \}\
  private async findSimilarTemplates(prd: string): Promise<any[]> \{ /* \uc0\u23454 \u29616  */ return []; \}\
  private insertOrgStructure(prd: string, content: any): string \{ /* \uc0\u23454 \u29616  */ return prd; \}\
  private insertPermissions(prd: string, content: any): string \{ /* \uc0\u23454 \u29616  */ return prd; \}\
