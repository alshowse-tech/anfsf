    // 3. \uc0\u35760 \u24405 \u21453 \u39304 \u65288 \u24322 \u27493 \u65292 \u19981 \u38459 \u22622 \u20027 \u27969 \u31243 \u65289 \
    this.recordFeedbackAsync(completionResult);\
    \
    // 4. \uc0\u20351 \u29992 \u34917 \u20840 \u21518 \u30340 PRD\u36827 \u34892 \u21518 \u32493 \u22788 \u29702 \
    console.log(`\uc0\u9989  PRD\u34917 \u20840 \u23436 \u25104 \u65292 \u20849 $\{completionResult.completions.length\}\u26465 \u24314 \u35758 \u65292 \u25972 \u20307 \u32622 \u20449 \u24230 $\{(completionResult.confidence * 100).toFixed(0)\}%`);\
    return this.standardRefine(completionResult.completedPrd);\
  \}\
  \
  private async launchConfirmationUI(result: CompletionResult): Promise<boolean> \{\
    // \uc0\u21551 \u21160 HTTP\u26381 \u21153 \u22120 \u25552 \u20379 \u30830 \u35748 \u30028 \u38754 \
    const port = await this.startConfirmationServer(result);\
    const uiUrl = `http://localhost:$\{port\}`;\
    \
    console.log(`\uc0\u55357 \u56523  \u35831 \u22312 \u27983 \u35272 \u22120 \u20013 \u30830 \u35748 \u34917 \u20840 \u24314 \u35758 : $\{uiUrl\}`);\
    \
    // \uc0\u31561 \u24453 \u29992 \u25143 \u30830 \u35748 \u65288 \u38459 \u22622 \u31561 \u24453 \u65289 \
    return this.waitForConfirmation(port);\
  \}\
  \
  private async startConfirmationServer(result: CompletionResult): Promise<number> \{\
    const express = require('express');\
    const app = express();\
    const port = 3456;\
    \
    app.use(express.json());\
    app.use(express.static('src/ui'));\
    \
    // API\uc0\u31471 \u28857 \
    app.get('/api/prd/completions', (req, res) => \{\
      res.json(this.formatCompletionsForUI(result));\
    \});\
    \
    app.post('/api/prd/accept', (req, res) => \{\
      const \{ completionId \} = req.body;\
      this.feedbackLoop.recordFeedback(\{\
        completionId,\
        type: this.getCompletionType(completionId, result),\
        content: this.getCompletionContent(completionId, result),\
        confidence: this.getCompletionConfidence(completionId, result),\
        action: 'accept',\
        timestamp: new Date()\
      \});\
      res.json(\{ success: true \});\
    \});\
    \
    app.post('/api/prd/reject', (req, res) => \{\
      const \{ completionId \} = req.body;\
      this.feedbackLoop.recordFeedback(\{\
        completionId,\
        type: this.getCompletionType(completionId, result),\
        content: this.getCompletionContent(completionId, result),\
        confidence: this.getCompletionConfidence(completionId, result),\
        action: 'reject',\
        timestamp: new Date()\
      \});\
      res.json(\{ success: true \});\
    \});\
    \
    app.post('/api/prd/modify', (req, res) => \{\
      const \{ completionId, modifiedValue \} = req.body;\
      this.feedbackLoop.recordFeedback(\{\
        completionId,\
        type: this.getCompletionType(completionId, result),\
        content: this.getCompletionContent(completionId, result),\
        confidence: this.getCompletionConfidence(completionId, result),\
        action: 'modify',\
        modifiedValue,\
        timestamp: new Date()\
      \});\
      res.json(\{ success: true \});\
    \});\
    \
    app.post('/api/prd/confirm', (req, res) => \{\
      res.json(\{ success: true \});\
    \});\
    \
    await new Promise<void>((resolve) => \{\
      app.listen(port, () => resolve());\
    \});\
    \
    return port;\
  \}\
  \
  private waitForConfirmation(port: number): Promise<boolean> \{\
    return new Promise((resolve) => \{\
      // \uc0\u31616 \u21333 \u23454 \u29616 \u65306 \u31561 \u24453 30\u31186 \u21518 \u33258 \u21160 \u30830 \u35748 \
      // \uc0\u29983 \u20135 \u29615 \u22659 \u24212 \u20351 \u29992 WebSocket\u25110 \u38271 \u36718 \u35810 \
      setTimeout(() => \{\
        resolve(true);\
      \}, 30000);\
    \});\
  \}\
  \
  private formatCompletionsForUI(result: CompletionResult): any \{\
    // \uc0\u25353 \u31867 \u22411 \u20998 \u32452 \
    const grouped = \{\
      org: [],\
      permission: [],\
      flow: [],\
      field: [],\
      query: [],\
      template: []\
    \};\
    \
    for (const completion of result.completions) \{\
      if (grouped[completion.type]) \{\
        grouped[completion.type].push(\{\
          ...completion,\
          autoApplied: completion.confidence >= 0.85\
        \});\
      \}\
    \}\
    \
    return grouped;\
  \}\
  \
  private getCompletionType(completionId: string, result: CompletionResult): string \{\
    const completion = result.completions.find(c => c.id === completionId);\
    return completion?.type || 'unknown';\
  \}\
  \
  private getCompletionContent(completionId: string, result: CompletionResult): any \{\
    const completion = result.completions.find(c => c.id === completionId);\
    return completion?.content || null;\
  \}\
  \
  private getCompletionConfidence(completionId: string, result: CompletionResult): number \{\
    const completion = result.completions.find(c => c.id === completionId);\
    return completion?.confidence || 0;\
  \}\
  \
  private async recordFeedbackAsync(result: CompletionResult): Promise<void> \{\
    // \uc0\u24322 \u27493 \u35760 \u24405 \u21453 \u39304 \u65292 \u19981 \u38459 \u22622 \u20027 \u27969 \u31243 \
    setImmediate(() => \{\
      for (const completion of result.completions) \{\
        this.feedbackLoop.recordFeedback(\{\
          completionId: completion.id,\
          type: completion.type,\
          content: completion.content,\
          confidence: completion.confidence,\
          action: completion.confidence >= 0.85 ? 'accept' : 'pending',\
          timestamp: new Date()\
        \});\
      \}\
    \});\
  \}\
  \
  private async standardRefine(prd: string): Promise<RefinedGraph> \{\
    // \uc0\u21407 \u26377 \u30340 \u26631 \u20934 \u38656 \u27714 \u31934 \u28860 \u36923 \u36753 \
    // ... \uc0\u20445 \u25345 \u19981 \u21464 \
    return \{ nodes: [], edges: [] \};\
  \}\
\}\
```\
