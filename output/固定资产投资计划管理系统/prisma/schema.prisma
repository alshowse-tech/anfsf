  budgetAmount     Decimal  @map("budget_amount")
  approveDocNo     String   @map("approve_doc_no")
  constructionType String   @map("construction_type")
  fundSource       String   @map("fund_source")
  projectType      String   @map("project_type")
  responsibleDept  String   @map("responsible_dept")
  projectLeader    String   @map("project_leader")
  isKeyProject     String   @default("N") @map("is_key_project")
  planStartDate    DateTime @map("plan_start_date")
  planEndDate      DateTime @map("plan_end_date")
  syncMethod       String   @map("sync_method")
  syncTime         DateTime @map("sync_time")
