# 捷阅证券后端 - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
APP_NAME=捷阅证券后端
APP_VERSION=1.0.0
DEBUG=false

# ============================================
# Security
# ============================================
# Generate a strong secret key for production!
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jieyue_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# Redis (Queue & Cache)
# ============================================
REDIS_URL=redis://localhost:6379/0
QUEUE_PREFIX=jieyue:

# ============================================
# CORS Origins
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ============================================
# TikHub (Transcription Service)
# ============================================
TIKHUB_API_KEY=your-tikhub-api-key
TIKHUB_API_URL=https://api.tikhub.io/v1/transcribe

# ============================================
# Alibaba Bailian (Transcription Service)
# ============================================
BAILIAN_API_KEY=your-bailian-api-key
BAILIAN_API_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/transcription/transcription

# ============================================
# Alibaba OSS (Object Storage)
# ============================================
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=jieyue-media
OSS_ACCESS_KEY=your-oss-access-key
OSS_SECRET_KEY=your-oss-secret-key

# ============================================
# Layer 8.5 Governance
# ============================================
LAYER8_ENABLED=true
MCP_BUS_URL=redis://localhost:6379/1
